## -------------------------------------------
## Main

# beacon type = Sine
BCN_TYPE,0

## EKF source set
EK3_SRC_OPTIONS,0

EK3_SRC1_POSXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELXY,3
EK3_SRC1_VELZ,0
EK3_SRC1_YAW,1

# SITL - for copilot to fake SNS
GPS2_TYPE,100

# Primary
GPS_AUTO_SWITCH,1

# No GPS
GPS1_TYPE,1

## -------------------------------------------
## Tuning

# Beacon measurement noise
EK3_BCN_M_NSE,50

# Innovation gate width, %
EK3_BCN_I_GTE,1000

# Stabilization
ATC_RATE_P_MAX,90
ATC_RATE_R_MAX,90

# Wind process noise
EK3_WIND_P_NSE,0.5

## -------------------------------------------
## Debug behavior

# log data before arming to asist with diasnostics
LOG_DISARMED,1

# Do nothing on failsafe
FS_EKF_ACTION,0

# Don't trigger FS when Deadreckoning starts
FS_DR_ENABLE,0

# Only 1 core
EK3_IMU_MASK,1

# TODO
# FS_EKF_THRESH,0
# tornado: high-rate IMU logging + achievable clean cruise
SCHED_LOOP_RATE,1000
AIRSPEED_CRUISE,30
ARSPD_FBW_MIN,12
ARSPD_FBW_MAX,35
