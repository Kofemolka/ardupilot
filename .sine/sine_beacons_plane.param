## -------------------------------------------
## Main

# beacon type = Sine
BCN_TYPE,4

## EKF source set
EK3_SRC_OPTIONS,0

EK3_SRC1_POSXY,4
EK3_SRC1_POSZ,1
EK3_SRC1_VELXY,0
EK3_SRC1_VELZ,0
EK3_SRC1_YAW,1

# Enable GPS driver so GPS_RAW_INT / GPS2_RAW stream to GCS,
# but EKF sources are all beacon/baro so GPS data is never fused.
# To prevent GPS from also setting the EKF origin, call
# set_ekf_origin() via MAVLink immediately on connect (ap.py).
GPS1_TYPE,1
GPS2_TYPE,100
GPS_AUTO_SWITCH,0

## -------------------------------------------
## Tuning

# Beacon measurement noise
EK3_BCN_M_NSE,50

# Innovation gate width, %
EK3_BCN_I_GTE,1000

# Wind process noise
EK3_WIND_P_NSE,0.5

## -------------------------------------------
## Debug behavior

# log data before arming to asist with diasnostics
LOG_DISARMED,1

# Do nothing on failsafe
FS_EKF_ACTION,0

# Don't trigger FS when Deadreckoning starts
FS_DR_ENABLE,0

# Only 1 core
EK3_IMU_MASK,1

# TODO
# FS_EKF_THRESH,0