## -------------------------------------------
## Main

# beacon type = Sine
BCN_TYPE,4

## EKF source set
EK3_SRC_OPTIONS,0

# GPS
EK3_SRC1_POSXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELXY,3
EK3_SRC1_VELZ,3
EK3_SRC1_YAW,1

# IMU
EK3_SRC2_POSXY,0
EK3_SRC2_POSZ,1
EK3_SRC2_VELXY,0
EK3_SRC2_VELZ,0
EK3_SRC2_YAW,1

# BCN
EK3_SRC3_POSXY,4
EK3_SRC3_POSZ,1
EK3_SRC3_VELXY,0
EK3_SRC3_VELZ,0
EK3_SRC3_YAW,1

GPS1_TYPE,1
GPS2_TYPE,100
GPS_AUTO_SWITCH,0

## -------------------------------------------
## Tuning

# Beacon measurement noise
EK3_BCN_M_NSE,50

# Innovation gate width, %
EK3_BCN_I_GTE,1000

# Wind process noise
EK3_WIND_P_NSE,0.5

## -------------------------------------------
## Debug behavior

# log data before arming to asist with diasnostics
LOG_DISARMED,1

# Do nothing on failsafe
FS_EKF_ACTION,0

# Don't trigger FS when Deadreckoning starts
FS_DR_ENABLE,0

# Only 1 core
EK3_IMU_MASK,1

# LUA
SCR_ENABLE,1

